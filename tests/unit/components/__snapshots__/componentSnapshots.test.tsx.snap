              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        </button>
        <div
          aria-label="Playback speed"
          class="ml-1 flex items-center gap-0.5 rounded-md bg-zinc-100 p-0.5 dark:bg-zinc-800"
          role="group"
        >
          <button
            aria-pressed="false"
            class="rounded px-1.5 py-0.5 text-2xs font-mono font-semibold transition-colors text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-200"
            title="0.5x speed"
          >
            0.5x
          </button>
          <button
            aria-pressed="true"
            class="rounded px-1.5 py-0.5 text-2xs font-mono font-semibold transition-colors bg-white text-teal-700 shadow-sm dark:bg-zinc-900 dark:text-teal-400"
            title="1x speed"
          >
            1x
          </button>
          <button
            aria-pressed="false"
            class="rounded px-1.5 py-0.5 text-2xs font-mono font-semibold transition-colors text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-200"
            title="2x speed"
          >
            2x
          </button>
          <button
            aria-pressed="false"
            class="rounded px-1.5 py-0.5 text-2xs font-mono font-semibold transition-colors text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-200"
            title="4x speed"
          >
            4x
          </button>
        </div>
      </div>
      <div
        class="min-w-0 flex flex-1 items-center gap-3"
      >
        <input
          aria-label="Scrub to step"
          aria-valuemax="1"
          aria-valuemin="0"
          aria-valuenow="0"
          class="h-1.5 w-full cursor-pointer appearance-none rounded-lg bg-zinc-200 dark:bg-zinc-700 accent-teal-600 dark:accent-teal-400"
          max="1"
          min="0"
          type="range"
          value="0"
        />
        <span
          class="shrink-0 font-mono text-xs text-zinc-400 dark:text-zinc-500"
        >
          1 / 2
        </span>
      </div>
    </div>
    <p
      class="mt-2 text-2xs text-zinc-400 dark:text-zinc-600"
    >
      Shortcuts: Space play/pause · ←/→ step · Home/R restart · End jump to last step
    </p>
  </div>
</DocumentFragment>
`;
